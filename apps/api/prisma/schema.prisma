// Prisma Schema — Equipment Rental Management Platform
// Database: PostgreSQL 16

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
  WAREHOUSE

  @@map("user_role")
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  RETURNED
  CANCELLED

  @@map("reservation_status")
}

enum PaymentType {
  RENTAL
  DEPOSIT
  REFUND
  DAMAGE

  @@map("payment_type")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum InventoryAction {
  RECEIVED
  RELEASED
  DAMAGED
  MAINTENANCE
  ADJUSTMENT

  @@map("inventory_action")
}

enum NotificationType {
  RESERVATION_APPROVED
  RESERVATION_REJECTED
  UPCOMING_RETURN
  RESERVATION_EXPIRED

  @@map("notification_type")
}

enum UploadType {
  IDENTITY_DOCUMENT
  RENTAL_AGREEMENT
  EQUIPMENT_IMAGE

  @@map("upload_type")
}

enum ActivityAction {
  LOGIN
  LOGOUT
  REGISTER
  RESERVATION_CREATED
  RESERVATION_UPDATED
  PAYMENT
  INVENTORY_CHANGE
  EQUIPMENT_CREATED
  EQUIPMENT_UPDATED
  EQUIPMENT_DELETED

  @@map("activity_action")
}

// ==========================================
// Models
// ==========================================

model User {
  id                String       @id @default(uuid()) @db.Uuid
  email             String       @unique @db.VarChar(255)
  passwordHash      String       @map("password_hash") @db.VarChar(255)
  firstName         String       @map("first_name") @db.VarChar(100)
  lastName          String       @map("last_name") @db.VarChar(100)
  phone             String?      @db.VarChar(20)
  role              UserRole     @default(CUSTOMER)
  isActive          Boolean      @default(true) @map("is_active")
  emailVerifiedAt   DateTime?    @map("email_verified_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  customerReservations Reservation[] @relation("CustomerReservations")
  approvedReservations Reservation[] @relation("ApprovedReservations")
  inventoryLogs        InventoryLog[]
  notifications        Notification[]
  uploads              Upload[]
  activityLogs         ActivityLog[]
  refreshTokens        RefreshToken[]

  @@map("users")
  @@index([role], name: "idx_users_role")
  @@index([isActive], name: "idx_users_is_active")
}

model Category {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique @db.VarChar(100)
  description String?     @db.Text
  slug        String      @unique @db.VarChar(100)
  imageUrl    String?     @map("image_url") @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  equipment   Equipment[]

  @@map("categories")
  @@index([slug], name: "idx_categories_slug")
}

model Equipment {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String           @db.VarChar(255)
  description        String?          @db.Text
  rentalPricePerDay  Decimal          @map("rental_price_per_day") @db.Decimal(10, 2)
  depositAmount      Decimal          @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  stockQuantity      Int              @map("stock_quantity")
  availableQuantity  Int              @map("available_quantity")
  specifications     Json?            @db.JsonB
  qrCode             String?          @map("qr_code") @db.VarChar(500)
  categoryId         String           @map("category_id") @db.Uuid
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  // Relations
  category           Category         @relation(fields: [categoryId], references: [id])
  images             EquipmentImage[]
  reservationItems   ReservationItem[]
  inventoryLogs      InventoryLog[]

  @@map("equipment")
  @@index([categoryId], name: "idx_equipment_category_id")
  @@index([isActive], name: "idx_equipment_is_active")
  @@index([name], name: "idx_equipment_name")
  @@index([isActive, availableQuantity], name: "idx_equipment_availability")
}

model EquipmentImage {
  id          String    @id @default(uuid()) @db.Uuid
  equipmentId String    @map("equipment_id") @db.Uuid
  imageUrl    String    @map("image_url") @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isPrimary   Boolean   @default(false) @map("is_primary")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@map("equipment_images")
  @@index([equipmentId], name: "idx_equipment_images_equipment_id")
}

model Reservation {
  id                String            @id @default(uuid()) @db.Uuid
  reservationNumber String            @unique @map("reservation_number") @db.VarChar(20)
  customerId        String            @map("customer_id") @db.Uuid
  approvedBy        String?           @map("approved_by") @db.Uuid
  status            ReservationStatus @default(PENDING)
  pickupDate        DateTime          @map("pickup_date") @db.Date
  returnDate        DateTime          @map("return_date") @db.Date
  actualReturnDate  DateTime?         @map("actual_return_date") @db.Date
  totalAmount       Decimal           @map("total_amount") @db.Decimal(12, 2)
  depositTotal      Decimal           @map("deposit_total") @db.Decimal(12, 2)
  notes             String?           @db.Text
  rejectionReason   String?           @map("rejection_reason") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  customer          User              @relation("CustomerReservations", fields: [customerId], references: [id])
  approver          User?             @relation("ApprovedReservations", fields: [approvedBy], references: [id])
  items             ReservationItem[]
  payments          Payment[]
  uploads           Upload[]

  @@map("reservations")
  @@index([customerId], name: "idx_reservations_customer_id")
  @@index([status], name: "idx_reservations_status")
  @@index([pickupDate, returnDate], name: "idx_reservations_dates")
}

model ReservationItem {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @map("reservation_id") @db.Uuid
  equipmentId   String      @map("equipment_id") @db.Uuid
  quantity      Int         @default(1)
  unitPrice     Decimal     @map("unit_price") @db.Decimal(10, 2)
  subtotal      Decimal     @db.Decimal(12, 2)
  deposit       Decimal     @db.Decimal(10, 2)

  // Relations
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  equipment     Equipment   @relation(fields: [equipmentId], references: [id])

  @@unique([reservationId, equipmentId])
  @@map("reservation_items")
  @@index([reservationId], name: "idx_reservation_items_reservation_id")
  @@index([equipmentId], name: "idx_reservation_items_equipment_id")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @map("reservation_id") @db.Uuid
  transactionId String        @unique @map("transaction_id") @db.VarChar(50)
  amount        Decimal       @db.Decimal(12, 2)
  type          PaymentType
  status        PaymentStatus @default(PENDING)
  paymentMethod String?       @map("payment_method") @db.VarChar(50)
  metadata      Json?         @db.JsonB
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  reservation   Reservation   @relation(fields: [reservationId], references: [id])

  @@map("payments")
  @@index([reservationId], name: "idx_payments_reservation_id")
  @@index([status], name: "idx_payments_status")
}

model InventoryLog {
  id             String          @id @default(uuid()) @db.Uuid
  equipmentId    String          @map("equipment_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  action         InventoryAction
  quantityChange Int             @map("quantity_change")
  notes          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")

  // Relations
  equipment      Equipment       @relation(fields: [equipmentId], references: [id])
  user           User            @relation(fields: [userId], references: [id])

  @@map("inventory_logs")
  @@index([equipmentId], name: "idx_inventory_logs_equipment_id")
  @@index([createdAt], name: "idx_inventory_logs_created_at")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @db.VarChar(255)
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  data      Json?            @db.JsonB
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user      User             @relation(fields: [userId], references: [id])

  @@map("notifications")
  @@index([userId, isRead], name: "idx_notifications_user_id_is_read")
  @@index([createdAt], name: "idx_notifications_created_at")
}

model Upload {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  reservationId String?     @map("reservation_id") @db.Uuid
  type          UploadType
  fileName      String      @map("file_name") @db.VarChar(255)
  fileUrl       String      @map("file_url") @db.VarChar(500)
  mimeType      String      @map("mime_type") @db.VarChar(100)
  fileSize      Int         @map("file_size")
  createdAt     DateTime    @default(now()) @map("created_at")

  // Relations
  user          User         @relation(fields: [userId], references: [id])
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  @@map("uploads")
  @@index([userId], name: "idx_uploads_user_id")
  @@index([reservationId], name: "idx_uploads_reservation_id")
}

model ActivityLog {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @map("user_id") @db.Uuid
  action     ActivityAction
  entityType String?        @map("entity_type") @db.VarChar(50)
  entityId   String?        @map("entity_id") @db.Uuid
  oldValues  Json?          @map("old_values") @db.JsonB
  newValues  Json?          @map("new_values") @db.JsonB
  ipAddress  String?        @map("ip_address") @db.VarChar(45)
  userAgent  String?        @map("user_agent") @db.VarChar(500)
  createdAt  DateTime       @default(now()) @map("created_at")

  // Relations
  user       User?          @relation(fields: [userId], references: [id])

  @@map("activity_logs")
  @@index([userId], name: "idx_activity_logs_user_id")
  @@index([action], name: "idx_activity_logs_action")
  @@index([entityType, entityId], name: "idx_activity_logs_entity")
  @@index([createdAt], name: "idx_activity_logs_created_at")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([userId], name: "idx_refresh_tokens_user_id")
  @@index([isRevoked, expiresAt], name: "idx_refresh_tokens_expires")
}
