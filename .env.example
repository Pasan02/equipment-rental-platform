# Environment Configuration
NODE_ENV=development
PORT=3000
WEB_PORT=3001

# Docker Services Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=equipment_rental_db
POSTGRES_PORT=5432

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/equipment_rental_db?schema=public"

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication Secrets
JWT_SECRET=super-secret-access-token-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Cloudflare R2 / AWS S3 File Storage
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
STORAGE_BUCKET_NAME=equipment-rental-bucket
STORAGE_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# SMTP Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Equipment Rental Platform <noreply@equipmentrental.com>"
